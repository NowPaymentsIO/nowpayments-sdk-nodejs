# Live integration tests for NOWPayments Mass payouts.
# Copy to .env.live. Never commit the real file.

# Required for all live tests
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PAYOUT_CURRENCY=trx
NOWPAYMENTS_PAYOUT_ADDRESS=
# Optional memo / destination tag
NOWPAYMENTS_PAYOUT_EXTRA_ID=

# Optional API/configuration overrides
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAYMENTS_LIVE_HTTP_TIMEOUT_MS=30000
NOWPAYMENTS_LIVE_WATCH_INTERVAL_MS=1000
NOWPAYMENTS_LIVE_WATCH_TIMEOUT_MS=20000
NOWPAYMENTS_LIVE_EVENTUAL_INTERVAL_MS=1000
NOWPAYMENTS_LIVE_EVENTUAL_ATTEMPTS=12
NOWPAYMENTS_NETWORK_FEE_PAID_BY=sender
NOWPAYMENTS_PAYOUT_IPN_URL=
NOWPAYMENTS_PAYOUT_DESCRIPTION=NOWPayments SDK live integration test
NOWPAYMENTS_LIVE_VERBOSE=false

# Read-only fee/preflight amount. When empty, the test obtains the current
# minimum and derives a value slightly above it, rounded up to 6 decimals.
NOWPAYMENTS_PAYOUT_PROBE_AMOUNT=

# Optional existing individual payout id for status and watcher tests.
# When empty, tests use the local state file, then the newest payout from listPayouts().
NOWPAYMENTS_EXISTING_PAYOUT_ID=

# Bearer authentication required only by create/verify tests.
# Prefer email/password so the SDK can obtain and refresh JWT automatically.
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
# Alternative: a current short-lived JWT.
NOWPAYMENTS_JWT_TOKEN=

# 2FA
# Base32 secret or otpauth:// URI. Required by auto-2FA.
NOWPAYMENTS_2FA_SECRET=
# Manual flow without a secret: paste a fresh 6-digit code just before running.
NOWPAYMENTS_2FA_CODE=

# ---------------------------------------------------------------------------
# REAL-FUNDS HIGH-LEVEL TESTS
# No payout is created unless every field below is deliberately configured.
# ---------------------------------------------------------------------------
NOWPAYMENTS_LIVE_PAYOUT_CONFIRM=
# Exact required value:
# NOWPAYMENTS_LIVE_PAYOUT_CONFIRM=I_UNDERSTAND_THIS_SENDS_REAL_FUNDS

NOWPAYMENTS_LIVE_PAYOUT_AMOUNT=
# Independent hard cap checked before any create request.
NOWPAYMENTS_LIVE_MAX_PAYOUT_AMOUNT=
# Maximum total custody debit after the live preflight, including sender-paid fee.
NOWPAYMENTS_LIVE_MAX_TOTAL_DEBIT=
# Stable id for duplicate protection. Reusing it will not create another payout.
NOWPAYMENTS_LIVE_PAYOUT_RUN_ID=

# ---------------------------------------------------------------------------
# ADDITIONAL REAL-FUNDS RAW-CLIENT TEST
# This creates a separate payout through sdk.raw.
# ---------------------------------------------------------------------------
NOWPAYMENTS_LIVE_RAW_PAYOUT_CONFIRM=
# Exact required value:
# NOWPAYMENTS_LIVE_RAW_PAYOUT_CONFIRM=I_UNDERSTAND_THIS_BYPASSES_HIGH_LEVEL_CREATE_AND_SENDS_REAL_FUNDS
NOWPAYMENTS_LIVE_RAW_PAYOUT_RUN_ID=

# Local idempotency/recovery state; contains no credentials or 2FA secrets.
NOWPAYMENTS_LIVE_STATE_FILE=.nowpayments-live-payout-test-state.json
