# Core API access
NOWPAYMENTS_API_KEY=paste_api_key
NOWPAYMENTS_EMAIL=paste_dashboard_login
NOWPAYMENTS_PASSWORD=paste_dashboard_password
# Optional alternative to email/password. JWTs are short-lived.
NOWPAYMENTS_JWT_TOKEN=

# Payment IPN / redirects
NOWPAYMENTS_IPN_SECRET=paste_ipn_secret
NOWPAYMENTS_IPN_URL=https://example.com/webhooks/nowpayments
NOWPAYMENTS_REDIRECT_SUCCESS=https://example.com/payment/success
NOWPAYMENTS_REDIRECT_CANCEL=https://example.com/payment/cancel

# Mass payouts
# Keep this Base32 secret in a secrets manager. When set, new payouts are verified automatically.
NOWPAYMENTS_2FA_SECRET=
# Manual flow only: current six-digit code from the authenticator app or email.
NOWPAYMENTS_2FA_CODE=
NOWPAYMENTS_PAYOUT_IPN_URL=https://example.com/webhooks/nowpayments/payouts
NOWPAYMENTS_PAYOUT_ADDRESS=
NOWPAYMENTS_PAYOUT_CURRENCY=trx
NOWPAYMENTS_PAYOUT_AMOUNT=10
